<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- ui-test-manifest exports this for instrumentation; Robolectric launches it in-process. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <!-- Developer bridge for the xiaoman CLI (adb shell am broadcast). Debug builds only. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="dev.xiaoman.debug.RUN" />
                <action android:name="dev.xiaoman.debug.STOP" />
                <action android:name="dev.xiaoman.debug.RELOAD_SKILLS" />
                <action android:name="dev.xiaoman.debug.SAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
